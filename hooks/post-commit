#!/bin/sh

branch=$(git rev-parse --abbrev-ref HEAD)
failed=0

for remote in $(git remote); do
  printf '%s\n' "post-commit: pushing $branch -> $remote"
  if ! git push "$remote" "$branch"; then
    printf '%s\n' "post-commit: push to $remote failed" >&2
    failed=1
  fi

  if [ "$remote" = "amvera" ] && [ "$branch" = "main" ]; then
    printf '%s\n' 'post-commit: synchronizing main -> amvera/master'
    if ! git push "$remote" main:master; then
      printf '%s\n' 'post-commit: push to amvera/master failed' >&2
      failed=1
    fi
  fi
done

exit "$failed"